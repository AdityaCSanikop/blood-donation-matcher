@@ -0,0 +1,57 @@
+@import "tailwindcss";
+
+/*
+ * Visual language: the blood-bag label.
+ * ABO groups use the label colours hospital staff already know from bags
+ * (A yellow, B pink, O blue, AB white); Rh-negative is shown inverted.
+ * Everything else stays quiet so urgency and blood group are what you see.
+ */
+@theme {
+  --color-paper: #f2f5f6;
+  --color-surface: #ffffff;
+  --color-ink: #13283b;
+  --color-ink-soft: #4a5d6e;
+  --color-line: #cfd9de;
+  --color-line-soft: #e3eaed;
+
+  --color-venous: #9b1c2e;      /* critical, destructive, primary action */
+  --color-venous-dark: #7a1423;
+  --color-venous-wash: #fbeaec;
+  --color-amber: #a8650c;       /* high urgency, warnings */
+  --color-amber-wash: #fdf1dc;
+  --color-teal: #1f6b6f;        /* ready / success / medium */
+  --color-teal-wash: #e2f1f1;
+  --color-slate-wash: #e9eef1;
+
+  --color-abo-a: #f6d54a;
+  --color-abo-b: #f3a6bd;
+  --color-abo-o: #8cc4ee;
+  --color-abo-ab: #ffffff;
+
+  --font-sans: "IBM Plex Sans", ui-sans-serif, system-ui, "Segoe UI", sans-serif;
+  --font-label: "IBM Plex Sans Condensed", "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
+}
+
+html {
+  background: var(--color-paper);
+  color: var(--color-ink);
+}
+body {
+  font-family: var(--font-sans);
+  font-size: 15px;
+  line-height: 1.5;
+}
+h1, h2, h3 {
+  font-family: var(--font-label);
+  letter-spacing: -0.01em;
+}
+:focus-visible {
+  outline: 3px solid var(--color-teal);
+  outline-offset: 2px;
+  border-radius: 2px;
+}
+.tabular { font-variant-numeric: tabular-nums; }
+
+@media (prefers-reduced-motion: reduce) {
+  * { animation: none !important; transition: none !important; }
+}
