+"use client";
+import Link from "next/link";
+import type { ButtonHTMLAttributes, InputHTMLAttributes, ReactNode, SelectHTMLAttributes, TextareaHTMLAttributes } from "react";
+import type { BloodGroup, RequestStatus, UrgencyLevel } from "@/lib/constants";
+
+const cx = (...parts: (string | false | null | undefined)[]) => parts.filter(Boolean).join(" ");
+
+// ------------------------------------------------------------------ tags
+
+const ABO_STYLE: Record<string, string> = {
+  A: "bg-abo-a text-ink",
+  B: "bg-abo-b text-ink",
+  O: "bg-abo-o text-ink",
+  AB: "bg-abo-ab text-ink",
+};
+
+/**
+ * Blood group shown the way a blood-bag label shows it: ABO letter on the
+ * group's label colour, Rh sign beside it (negative = inverted block).
+ * The letters carry the meaning; colour only speeds up recognition.
+ */
+export function BloodGroupTag({ group, size = "md" }: { group: BloodGroup | string; size?: "md" | "lg" }) {
+  const abo = group.replace(/[+-]$/, "");
+  const negative = group.endsWith("-");
+  const dims = size === "lg" ? "h-11 text-2xl" : "h-7 text-sm";
+  return (
+    <span
+      className={cx("inline-flex w-fit items-stretch overflow-hidden rounded-[3px] border-2 border-ink font-label font-semibold leading-none align-middle", dims)}
+      aria-label={`Blood group ${abo} ${negative ? "negative" : "positive"}`}
+    >
+      <span className={cx("flex items-center justify-center", size === "lg" ? "min-w-11 px-2" : "min-w-7 px-1.5", ABO_STYLE[abo] ?? "bg-white")}>{abo}</span>
+      <span className={cx("flex items-center justify-center border-l-2 border-ink", size === "lg" ? "w-8" : "w-5", negative ? "bg-ink text-white" : "bg-white text-ink")}>
+        {negative ? "−" : "+"}
+      </span>
+    </span>
+  );
+}
+
+const URGENCY_STYLE: Record<UrgencyLevel, string> = {
+  Critical: "bg-venous text-white border-venous",
+  High: "bg-amber-wash text-amber border-amber",
+  Medium: "bg-teal-wash text-teal border-teal",
+  Low: "bg-slate-wash text-ink-soft border-line",
+};
+export const URGENCY_BAR: Record<UrgencyLevel, string> = {
+  Critical: "border-l-venous border-l-[10px]",
+  High: "border-l-amber border-l-[7px]",
+  Medium: "border-l-teal border-l-[4px]",
+  Low: "border-l-line border-l-[4px]",
+};
+
+export function UrgencyTag({ level }: { level: UrgencyLevel }) {
+  return <span className={cx("inline-block w-fit rounded-[3px] border px-2 py-0.5 font-label text-sm font-semibold", URGENCY_STYLE[level])}>{level}</span>;
+}
+
+const STATUS_STYLE: Record<RequestStatus, string> = {
+  Pending: "bg-white text-ink border-ink",
+  Partially_Fulfilled: "bg-amber-wash text-amber border-amber",
+  Fulfilled: "bg-teal-wash text-teal border-teal",
+  Cancelled: "bg-slate-wash text-ink-soft border-line line-through",
+};
+export function StatusTag({ status }: { status: RequestStatus }) {
+  return (
+    <span className={cx("inline-block rounded-full border px-2.5 py-0.5 text-sm font-medium whitespace-nowrap", STATUS_STYLE[status])}>
+      {status.replace("_", " ")}
+    </span>
+  );
+}
+
+export function Pill({ tone = "neutral", children }: { tone?: "good" | "warn" | "bad" | "neutral"; children: ReactNode }) {
+  const tones = {
+    good: "bg-teal-wash text-teal",
+    warn: "bg-amber-wash text-amber",
+    bad: "bg-venous-wash text-venous",
+    neutral: "bg-slate-wash text-ink-soft",
+  };
+  return <span className={cx("inline-block rounded-full px-2.5 py-0.5 text-sm font-medium whitespace-nowrap", tones[tone])}>{children}</span>;
+}
+
+/** One block per unit of blood: filled = donated, outlined = still needed. */
+export function UnitMeter({ required, fulfilled }: { required: number; fulfilled: number }) {
+  return (
+    <span className="inline-flex items-center gap-2 align-middle" aria-label={`${fulfilled} of ${required} units donated`}>
+      <span className="inline-flex gap-[3px]" aria-hidden="true">
+        {Array.from({ length: required }, (_, i) => (
+          <span key={i} className={cx("h-4 w-2.5 rounded-[2px] border border-venous", i < fulfilled ? "bg-venous" : "bg-white")} />
+        ))}
+      </span>
+      <span className="tabular text-sm text-ink-soft">
+        {fulfilled}/{required}
+      </span>
+    </span>
+  );
+}
+
+// --------------------------------------------------------------- controls
+
+type ButtonProps = ButtonHTMLAttributes<HTMLButtonElement> & { variant?: "primary" | "secondary" | "danger" | "quiet"; busy?: boolean };
+const BUTTON_STYLE = {
+  primary: "bg-ink text-white hover:bg-[#0b1b29] border-ink",
+  secondary: "bg-white text-ink hover:bg-slate-wash border-ink",
+  danger: "bg-white text-venous hover:bg-venous-wash border-venous",
+  quiet: "bg-transparent text-ink-soft hover:text-ink hover:bg-slate-wash border-transparent",
+};
+export function Button({ variant = "primary", busy, disabled, className, children, ...rest }: ButtonProps) {
+  return (
+    <button
+      {...rest}
+      disabled={disabled || busy}
+      className={cx(
+        "inline-flex items-center justify-center gap-2 rounded-[4px] border px-3.5 py-2 text-sm font-semibold transition-colors disabled:cursor-not-allowed disabled:opacity-55",
+        BUTTON_STYLE[variant],
+        className,
+      )}
+    >
+      {busy ? "Working…" : children}
+    </button>
+  );
+}
+
+export function LinkButton({ href, children, variant = "secondary" }: { href: string; children: ReactNode; variant?: "primary" | "secondary" }) {
+  return (
+    <Link href={href} className={cx("inline-flex items-center rounded-[4px] border px-3.5 py-2 text-sm font-semibold", BUTTON_STYLE[variant])}>
+      {children}
+    </Link>
+  );
+}
+
+const FIELD = "w-full rounded-[4px] border border-line bg-white px-3 py-2 text-[15px] text-ink placeholder:text-ink-soft/60 focus:border-teal";
+
+export function Field({ label, error, hint, children }: { label: string; error?: string; hint?: string; children: ReactNode }) {
+  return (
+    <label className="block">
+      <span className="mb-1 block text-sm font-medium text-ink">{label}</span>
+      {children}
+      {hint && !error && <span className="mt-1 block text-sm text-ink-soft">{hint}</span>}
+      {error && (
+        <span role="alert" className="mt-1 block text-sm font-medium text-venous">
+          {error}
+        </span>
+      )}
+    </label>
+  );
+}
+export const Input = (props: InputHTMLAttributes<HTMLInputElement>) => <input {...props} className={cx(FIELD, props.className)} />;
+export const Select = (props: SelectHTMLAttributes<HTMLSelectElement>) => <select {...props} className={cx(FIELD, "pr-8", props.className)} />;
+export const Textarea = (props: TextareaHTMLAttributes<HTMLTextAreaElement>) => <textarea {...props} className={cx(FIELD, props.className)} />;
+
+// ---------------------------------------------------------------- layout
+
+export function PageHeader({ title, lead, action }: { title: string; lead?: string; action?: ReactNode }) {
+  return (
+    <header className="mb-6 flex flex-wrap items-end justify-between gap-4">
+      <div>
+        <h1 className="text-3xl font-semibold">{title}</h1>
+        {lead && <p className="mt-1 max-w-[68ch] text-ink-soft">{lead}</p>}
+      </div>
+      {action}
+    </header>
+  );
+}
+
+export function Panel({ title, action, children, className }: { title?: string; action?: ReactNode; children: ReactNode; className?: string }) {
+  return (
+    <section className={cx("min-w-0 rounded-md border border-line bg-surface", className)}>
+      {(title || action) && (
+        <div className="flex flex-wrap items-center justify-between gap-3 border-b border-line-soft px-4 py-3">
+          {title && <h2 className="text-lg font-semibold">{title}</h2>}
+          {action}
+        </div>
+      )}
+      <div className="p-4">{children}</div>
+    </section>
+  );
+}
+
+export function Notice({ tone, children, onDismiss }: { tone: "success" | "error" | "info" | "warn"; children: ReactNode; onDismiss?: () => void }) {
+  const tones = {
+    success: "border-teal bg-teal-wash text-teal",
+    error: "border-venous bg-venous-wash text-venous",
+    warn: "border-amber bg-amber-wash text-amber",
+    info: "border-line bg-slate-wash text-ink",
+  };
+  return (
+    <div role={tone === "error" ? "alert" : "status"} className={cx("flex items-start justify-between gap-3 rounded-[4px] border-l-4 px-3.5 py-2.5 text-[15px] font-medium", tones[tone])}>
+      <div>{children}</div>
+      {onDismiss && (
+        <button type="button" onClick={onDismiss} className="shrink-0 text-sm underline">
+          Dismiss
+        </button>
+      )}
+    </div>
+  );
+}
+
+export function Loading({ what = "Loading" }: { what?: string }) {
+  return (
+    <p role="status" className="py-8 text-center text-ink-soft">
+      {what}…
+    </p>
+  );
+}
+
+export function Empty({ title, children }: { title: string; children?: ReactNode }) {
+  return (
+    <div className="rounded-md border border-dashed border-line px-4 py-8 text-center">
+      <p className="font-label text-lg font-semibold">{title}</p>
+      {children && <div className="mx-auto mt-1 max-w-[52ch] text-ink-soft">{children}</div>}
+    </div>
+  );
+}
+
+export function LoadError({ message, onRetry }: { message: string; onRetry: () => void }) {
+  return (
+    <Notice tone="error">
+      {message}{" "}
+      <button type="button" className="underline" onClick={onRetry}>
+        Try again
+      </button>
+    </Notice>
+  );
+}
+
+export function Table({ head, children, compact }: { head: ReactNode[]; children: ReactNode; compact?: boolean }) {
+  return (
+    <div className="overflow-x-auto">
+      <table className={cx("w-full border-collapse text-left", compact ? "min-w-[330px]" : "min-w-[640px]")}>
+        <thead>
+          <tr className="border-b-2 border-ink text-sm text-ink-soft">
+            {head.map((h, i) => (
+              <th key={i} scope="col" className={cx("px-3 py-2 font-medium", !compact && "whitespace-nowrap")}>
+                {h}
+              </th>
+            ))}
+          </tr>
+        </thead>
+        <tbody className="[&>tr]:border-b [&>tr]:border-line-soft [&>tr:last-child]:border-0 [&_td]:px-3 [&_td]:py-2.5 [&_td]:align-middle">{children}</tbody>
+      </table>
+    </div>
+  );
+}
+
+export function Stat({ label, value, note, tone }: { label: string; value: ReactNode; note?: string; tone?: "bad" }) {
+  return (
+    <div className="border-l-2 border-line pl-3">
+      <p className="text-sm text-ink-soft">{label}</p>
+      <p className={cx("tabular font-label text-3xl font-semibold leading-tight", tone === "bad" && "text-venous")}>{value}</p>
+      {note && <p className="text-sm text-ink-soft">{note}</p>}
+    </div>
+  );
+}
+
+export { cx };
