@@ -0,0 +1,116 @@
+"use client";
+import Link from "next/link";
+import { usePathname, useRouter } from "next/navigation";
+import { createContext, useContext, useEffect, useState, type ReactNode } from "react";
+import { api } from "@/lib/client";
+import type { Role } from "@/lib/constants";
+import { Loading, cx } from "./ui";
+
+export type Me = {
+  user_id: number;
+  email: string;
+  display_name: string;
+  role: Role;
+  hospital_id: number | null;
+  donor_id: number | null;
+  hospital_name: string | null;
+  hospital_city: string | null;
+};
+
+const SessionContext = createContext<Me | null>(null);
+/** The signed-in user. Only call inside <AppShell>. */
+export const useMe = () => useContext(SessionContext)!;
+
+const STAFF_NAV = [
+  { href: "/", label: "Dashboard" },
+  { href: "/requests", label: "Blood requests" },
+  { href: "/donors", label: "Donors" },
+  { href: "/recipients", label: "Recipients" },
+  { href: "/donations", label: "Donations" },
+  { href: "/hospitals", label: "Hospitals" },
+  { href: "/activity", label: "Activity log" },
+];
+const DONOR_NAV = [{ href: "/me", label: "My donor profile" }];
+
+export function AppShell({ children, allow }: { children: ReactNode; allow: Role[] }) {
+  const router = useRouter();
+  const pathname = usePathname();
+  const [me, setMe] = useState<Me | null>(null);
+
+  useEffect(() => {
+    let cancelled = false;
+    api<Me>("/api/auth/me")
+      .then(({ data }) => {
+        if (cancelled) return;
+        if (!allow.includes(data.role)) {
+          router.replace(data.role === "DONOR" ? "/me" : "/");
+          return;
+        }
+        setMe(data);
+      })
+      .catch(() => {
+        if (!cancelled) router.replace("/login");
+      });
+    return () => {
+      cancelled = true;
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  async function signOut() {
+    await api("/api/auth/logout", { method: "POST" }).catch(() => {});
+    router.replace("/login");
+  }
+
+  if (!me) {
+    return (
+      <main className="mx-auto max-w-5xl px-4">
+        <Loading what="Checking your sign-in" />
+      </main>
+    );
+  }
+
+  const nav = me.role === "STAFF" ? STAFF_NAV : DONOR_NAV;
+  const isActive = (href: string) => (href === "/" ? pathname === "/" : pathname.startsWith(href));
+
+  return (
+    <SessionContext.Provider value={me}>
+      <div className="min-h-screen lg:grid lg:grid-cols-[232px_minmax(0,1fr)]">
+        <aside className="border-b border-line bg-ink text-white lg:min-h-screen lg:border-b-0">
+          <div className="flex items-center justify-between gap-3 px-4 py-3 lg:block lg:py-5">
+            <Link href={me.role === "STAFF" ? "/" : "/me"} className="block font-label text-lg leading-tight font-semibold">
+              Blood Donation
+              <br className="hidden lg:block" /> Matcher
+            </Link>
+            <p className="text-right text-sm text-white/70 lg:mt-3 lg:text-left">
+              {me.display_name}
+              <br />
+              <span className="text-white/55">{me.role === "STAFF" ? (me.hospital_name ?? "Hospital staff") : "Donor"}</span>
+            </p>
+          </div>
+          <nav aria-label="Main" className="flex gap-1 overflow-x-auto px-2 pb-2 lg:block lg:space-y-0.5 lg:px-2">
+            {nav.map((item) => (
+              <Link
+                key={item.href}
+                href={item.href}
+                aria-current={isActive(item.href) ? "page" : undefined}
+                className={cx(
+                  "block rounded-[4px] px-3 py-2 text-[15px] whitespace-nowrap",
+                  isActive(item.href) ? "bg-white font-semibold text-ink" : "text-white/85 hover:bg-white/10",
+                )}
+              >
+                {item.label}
+              </Link>
+            ))}
+            <button type="button" onClick={signOut} className="block rounded-[4px] px-3 py-2 text-left text-[15px] whitespace-nowrap text-white/85 hover:bg-white/10 lg:mt-4 lg:w-full">
+              Sign out
+            </button>
+          </nav>
+        </aside>
+        <main className="min-w-0 px-4 py-6 sm:px-8 lg:py-8">
+          <div className="mx-auto max-w-6xl">{children}</div>
+        </main>
+      </div>
+    </SessionContext.Provider>
+  );
+}
