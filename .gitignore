# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real credentials never go into Git; only the template does
.env*
!.env.example

# test output
/test-results/
/playwright-report/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local planning notes — kept on disk, not published
# TEAM_TASKS.md: local-only during development; remove this line to include it in the final submission
/TEAM_TASKS.md
/CLAUDE_CODE_HANDOFF.md
/docs/PROGRESS.md
# team and planning documents: local-only
/PROJECT_PLAN.md
/PROGRESS.md
/DECISIONS.md
/docs/TEAM.md
