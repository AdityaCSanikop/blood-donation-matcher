# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by Git — never commit real credentials.

# ---- MySQL (primary database) -------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=blood_matcher
# Account the web application connects with. It only needs
# SELECT, INSERT, UPDATE, DELETE, EXECUTE (see sql/07_app_user.example.sql).
MYSQL_USER=
MYSQL_PASSWORD=
# Optional: a more privileged account used ONLY by `npm run db:*` to create
# tables, triggers and views. Leave empty to use MYSQL_USER for that as well.
MYSQL_ADMIN_USER=
MYSQL_ADMIN_PASSWORD=

# ---- MongoDB (activity log) ---------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=blood_matcher_logs

# ---- Application ----------------------------------------------------------
# Secret used to sign login sessions. At least 32 characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# UTC offset in which "today" is decided (90-day rule, daily statistics).
APP_TIMEZONE=+05:30
# Password given to the four demo logins by `npm run db:seed` (default Demo@12345).
# SEED_PASSWORD=
